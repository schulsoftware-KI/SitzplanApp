<UserControl x:Class="SitzplanApp.Views.RaumplanTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SitzplanApp">

    <UserControl.Resources>
        <local:HexToBrushConverter x:Key="HexBrush"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,8"
                Margin="0,0,0,6">
            <DockPanel>
                <Button Content="+ Neue Gruppe" DockPanel.Dock="Left"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Padding="10,5" FontSize="11" FontFamily="Segoe UI"
                        Cursor="Hand"
                        Command="{Binding NeueGruppeCommand}"
                        Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="10" Foreground="#888"
                           Text="Gruppen verschieben: Ziehen  |  Bearbeiten: Klicken  |  Löschen: im Editor"/>

                <!-- Kollisionswarnung -->
                <Border DockPanel.Dock="Right" Background="#FCE4D6" CornerRadius="6"
                        Padding="10,4" Margin="8,0,0,0"
                        Visibility="{Binding ZeigeKollision, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding KollisionsText, Mode=OneWay}"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="#C0392B" VerticalAlignment="Center"/>
                        <Button Content="Trotzdem löschen" Margin="8,0,4,0"
                                FontSize="9" Padding="4,2"
                                Background="#C0392B" Foreground="White"
                                BorderThickness="0"
                                Command="{Binding LoeschenBestaetigenCommand}"
                                Visibility="{Binding ZeigeKollision, Converter={StaticResource BoolVis}}"/>
                        <Button Content="✕" FontSize="9" Padding="4,2"
                                Background="#DDDDDD" BorderThickness="0"
                                Command="{Binding LoeschenAbbrechenCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Geändert-Indikator -->
                <Border DockPanel.Dock="Right" Background="#E2EFDA" CornerRadius="6"
                        Padding="10,4" Margin="8,0,0,0"
                        Visibility="{Binding IstGeaendert, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="⚠ Geändert — Neu optimieren!" FontFamily="Segoe UI"
                               FontSize="10" Foreground="#1E6B34" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Canvas-Bereich -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#F0F4F8">
            <Canvas x:Name="cnvRaum"
                    Width="{Binding CanvasBreite}"
                    Height="{Binding CanvasHoehe}"
                    Background="#F0F4F8"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseMove="Canvas_MouseMove">

                <!-- Tafel -->
                <Border Canvas.Left="20" Canvas.Top="8"
                        Background="#1F3864" CornerRadius="6"
                        Width="{Binding CanvasBreite}" Height="40">
                    <TextBlock Text="TAFEL / VORNE" Foreground="White"
                               FontFamily="Segoe UI Semibold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Tischgruppen -->
                <ItemsControl ItemsSource="{Binding Gruppen}" x:Name="icGruppen">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}"/>
                            <Setter Property="Canvas.Top"  Value="{Binding CanvasTop}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Tisch-Rechteck -->
                                <Border Width="{Binding Breite}"
                                        Height="{Binding Hoehe}"
                                        CornerRadius="8"
                                        BorderThickness="{Binding RandStaerke, Mode=OneWay}"
                                        BorderBrush="{Binding RandFarbe, Mode=OneWay, Converter={StaticResource HexBrush}}"
                                        Background="White"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="Gruppe_MouseLeftButtonDown"
                                        MouseLeftButtonUp="Gruppe_MouseLeftButtonUp"
                                        MouseMove="Gruppe_MouseMove">
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="12" TextAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock FontFamily="Segoe UI" FontSize="10"
                                                   TextAlignment="Center" Foreground="#666"
                                                   HorizontalAlignment="Center">
                                            <Run Text="{Binding Sitzplaetze, Mode=OneWay}"/>
                                            <Run Text=" Plätze  "/>
                                            <Run Text="{Binding AusrichtungText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Editor-Popup -->
                                <Border Visibility="{Binding ZeigeEditor, Converter={StaticResource BoolVis}}"
                                        Background="White" CornerRadius="8"
                                        BorderBrush="#2E75B6" BorderThickness="1.5"
                                        Padding="10" Margin="0,0,0,-160"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Left"
                                        MinWidth="200"
                                        Panel.ZIndex="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                                          Color="#AAAAAA" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <!-- Name -->
                                        <TextBlock Text="Name" FontSize="9" Foreground="#888"/>
                                        <TextBox x:Name="tbName"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Margin="0,2,0,8"
                                                 BorderBrush="#CCCCCC" Padding="4,2"
                                                 LostFocus="TbName_LostFocus"/>

                                        <!-- Sitzplätze -->
                                        <TextBlock Text="Sitzplätze" FontSize="9" Foreground="#888"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                            <Button Content="−" Width="28" Height="26"
                                                    FontSize="14" FontWeight="Bold"
                                                    Background="#F0F0F0" BorderThickness="1"
                                                    Click="BtnMinus_Click"/>
                                            <TextBlock Text="{Binding Sitzplaetze}"
                                                       FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0" MinWidth="20"
                                                       TextAlignment="Center"/>
                                            <Button Content="+" Width="28" Height="26"
                                                    FontSize="14" FontWeight="Bold"
                                                    Background="#F0F0F0" BorderThickness="1"
                                                    Click="BtnPlus_Click"/>
                                        </StackPanel>

                                        <!-- Ausrichtung -->
                                        <TextBlock Text="Ausrichtung" FontSize="9" Foreground="#888"/>
                                        <Button Content="{Binding AusrichtungText, Mode=OneWay}"
                                                Margin="0,2,0,8" Height="26" FontSize="11"
                                                Background="#EBF3FB" BorderThickness="1"
                                                BorderBrush="#2E75B6"
                                                Click="BtnAusrichtung_Click"/>

                                        <!-- Löschen -->
                                        <Button Content="🗑 Gruppe löschen"
                                                Height="26" FontSize="11"
                                                Background="#FCE4D6" BorderThickness="1"
                                                BorderBrush="#C0392B" Foreground="#C0392B"
                                                Click="BtnLoeschen_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
