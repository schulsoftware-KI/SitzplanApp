<Window x:Class="SitzplanApp.Views.VerboteAuswahlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titel}"
        Width="460" Height="520"
        MinWidth="360" MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F7F9FC"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Titel}"
                   FontSize="14" FontWeight="Bold" Foreground="#5A2D82"/>

        <!-- Suchfeld -->
        <TextBox Grid.Row="2" x:Name="txtFilter"
                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 Height="28" FontSize="12" Padding="6,4"
                 BorderBrush="#9B59B6" BorderThickness="1.5"/>

        <!-- Liste -->
        <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4"
                Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GefilterteOptionen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4">
                                <CheckBox IsChecked="{Binding Gewaehlt}"
                                          FontFamily="Segoe UI"
                                          FontSize="{Binding Schriftgroesse}"
                                          FontWeight="{Binding Schriftgewicht}"
                                          Foreground="{Binding Farbe}"
                                          Content="{Binding Anzeigename}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status + Buttons -->
        <DockPanel Grid.Row="6">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="11" Foreground="#666">
                <Run Text="{Binding AnzahlGewaehlt, Mode=OneWay}"/>
                <Run Text=" Verbot(e) aktiv"/>
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Alle entfernen" Click="BtnAlleEntfernen_Click"
                        Padding="10,5" FontSize="11" Margin="0,0,6,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Abbrechen" Click="BtnAbbrechen_Click"
                        Padding="10,5" FontSize="11" Margin="0,0,6,0"
                        Background="#E0E0E0" Foreground="#333" BorderThickness="0" Cursor="Hand"/>
                <Button Content="OK" IsDefault="True" Click="BtnOK_Click"
                        Padding="16,5" FontSize="12"
                        Background="#7030A0" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
