<Window x:Class="SitzplanApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SitzplanApp.ViewModels"
        xmlns:local="clr-namespace:SitzplanApp"
        Title="Sitzplan-Optimierer" Height="900" Width="1560"
        MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter -->
        <local:HexToBrushConverter           x:Key="HexBrush"/>
        <local:BoolToVisibilityConverter     x:Key="BoolVis"/>
        <local:CountToVisibilityConverter    x:Key="CountVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <local:IstMarkiertConverter          x:Key="IstMarkiertConv"/>
        <local:IndexHighlightConverter       x:Key="IndexHighlight"/>

        <!-- DataTemplate für eine Wunsch-Kategorie (Zusammen / Nicht neben) -->
        <DataTemplate DataType="{x:Type vm:WunschListeVM}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Titel}" FontFamily="Segoe UI Semibold"
                           FontSize="11"
                           Foreground="{Binding TitelFarbe, Converter={StaticResource HexBrush}}"
                           Margin="0,0,0,3"/>

                <!-- Chips -->
                <ItemsControl ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,4" CornerRadius="11"
                                    Background="{Binding ChipHintergrund, Converter={StaticResource HexBrush}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="10,3,4,3">
                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding ChipVordergrund, Converter={StaticResource HexBrush}}"/>
                                    <!-- Prio-Badge: klick zykliert 1→2→3 -->
                                    <Button Command="{Binding PrioZyklusCommand}"
                                            ToolTip="{Binding PrioTooltip}"
                                            Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"
                                            Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="18" Height="18" CornerRadius="9"
                                                        Background="{Binding PrioFarbe, Converter={StaticResource HexBrush}}">
                                                    <TextBlock Text="{Binding PrioText}" FontSize="10"
                                                               Foreground="White" FontFamily="Segoe UI Semibold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Entfernen -->
                                    <Button Command="{Binding EntfernenCommand}"
                                            ToolTip="Entfernen"
                                            Margin="4,0,0,0" Cursor="Hand" BorderThickness="0"
                                            Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        Background="#00000000">
                                                    <TextBlock Text="✕" FontSize="10"
                                                               Foreground="{Binding ChipVordergrund, Converter={StaticResource HexBrush}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#33000000"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Eingabefeld mit Platzhalter -->
                <Grid>
                    <TextBox x:Name="txtWunschSuche"
                             Text="{Binding SuchText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding KannTippen}"
                             FontSize="11" Height="28" Padding="8,0" VerticalContentAlignment="Center"
                             BorderBrush="#CFCFCF" BorderThickness="1"
                             PreviewKeyDown="WunschSuche_PreviewKeyDown"/>
                    <TextBlock Text="{Binding PlatzhalterText}" FontSize="11" Foreground="#AAAAAA"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Vorschlagsliste -->
                <Border BorderBrush="#CFCFCF" BorderThickness="1" CornerRadius="4"
                        Margin="0,2,0,0" Background="White"
                        Visibility="{Binding VorschlaegeOffen, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Vorschlaege}" AlternationCount="99">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.HinzufuegenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Left" Cursor="Hand"
                                        FontSize="11" Padding="10,5" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource IndexHighlight}">
                                                        <Binding Path="(ItemsControl.AlternationIndex)"
                                                                 RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                        <Binding Path="DataContext.HighlightIndex"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EEF3FB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Button-Styles -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"      Value="#1F3864"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E75B6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1F7A4A"/>
        </Style>
        <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>
        <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#2E75B6"/>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#CCCCCC" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-Styles -->
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#1F3864"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <!-- DataTemplate für eine Lösung -->
        <DataTemplate x:Key="LoesungTemplate">
            <Grid Background="{Binding HintergrundFarbe, Converter={StaticResource HexBrush}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Warnungen -->
                    <RowDefinition Height="Auto"/>   <!-- Score-Banner -->
                    <RowDefinition Height="Auto"/>   <!-- Info-Zeile markierter Schüler -->
                    <RowDefinition Height="*"/>      <!-- Sitzplan -->
                </Grid.RowDefinitions>

                <!-- Warnungen (groß, rot, zuerst) -->
                <Border Grid.Row="0" Margin="4,4,4,0"
                        Background="#C0392B" CornerRadius="6"
                        Padding="14,10"
                        Visibility="{Binding Warnungen.Count,
                            Converter={StaticResource CountVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding WarnungenAufgeklappt, Mode=TwoWay}"
                                          Content="{Binding WarnungenToggleText}"
                                          Foreground="White" FontSize="11" Cursor="Hand"
                                          VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#A5281B" CornerRadius="4"
                                                Padding="8,2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{Binding WarnungenKopf}"
                                       FontFamily="Segoe UI Semibold" FontSize="14"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Warnungen}"
                                      Visibility="{Binding WarnungenAufgeklappt,
                                          Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="White" TextWrapping="Wrap"
                                               Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Score-Banner -->
                <Border Grid.Row="1" Padding="12,6" Margin="4,4,4,0" Background="White" CornerRadius="6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Sitzplanversion sichern"
                                Command="{Binding LoesungSpeichernCommand}"
                                ToolTip="Speichert diese Sitzordnung in der aktuellen Excel-Datei – wird nach einem Neustart wiederhergestellt"
                                Background="#27AE60" Foreground="White" BorderThickness="0"
                                Padding="14,7" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="🔍 Prüfen"
                                Command="{Binding ManuelleLoesungPruefenCommand}"
                                ToolTip="Aktuelle Sitzordnung gegen die (ggf. geänderten) Wünsche neu bewerten"
                                Background="#2E75B6" Foreground="White" BorderThickness="0"
                                Padding="10,4" FontSize="11" Cursor="Hand" Margin="8,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Zoom-Steuerung + Score (füllt den freien Platz links) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScoreText}" FontFamily="Segoe UI" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Border Width="1" Background="#DDD" Margin="12,1,12,1"/>
                            <TextBlock Text="Zoom" FontSize="11" Foreground="#555"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="−" Click="ZoomAus_Click" Width="24" Padding="0"
                                    FontSize="14" Cursor="Hand" ToolTip="Verkleinern (Strg + Mausrad)"/>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6,0">
                                <Slider Minimum="0.4" Maximum="1.5" Width="120"
                                        Value="{Binding Zoom, Mode=TwoWay}"
                                        TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                                <Button Content="Einpassen" Click="Einpassen_Click"
                                        FontSize="9" Padding="4,0" Margin="0,1,0,0"
                                        HorizontalAlignment="Center" Cursor="Hand"
                                        ToolTip="Zoom so setzen, dass der ganze Plan ins Fenster passt"/>
                            </StackPanel>
                            <Button Content="+" Click="ZoomEin_Click" Width="24" Padding="0"
                                    FontSize="14" Cursor="Hand" ToolTip="Vergrößern (Strg + Mausrad)"/>
                            <TextBlock Text="{Binding ZoomProzent}" FontSize="11" Foreground="#555"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Width="42"/>
                            <ToggleButton IsChecked="{Binding HilfeAufgeklappt, Mode=TwoWay}"
                                          Content="{Binding HilfeToggleText}"
                                          FontSize="11" Foreground="#1F3864" Cursor="Hand"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Legende &amp; Bedienungshinweise ein-/ausblenden">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#EEF2F7" CornerRadius="4"
                                                BorderBrush="#CBD6E2" BorderThickness="1"
                                                Padding="8,2">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Info-Zeile: Wünsche des markierten Schülers (volle Breite über dem Plan) -->
                <Border Grid.Row="2" Background="#FFF8DC" CornerRadius="6"
                        Padding="12,7" Margin="4,4,4,0"
                        BorderBrush="#FFD700" BorderThickness="1.5"
                        Visibility="{Binding ZeigeMarkierung, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding MarkierungKopf}"
                                   FontFamily="Segoe UI Semibold" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding MarkierungWuensche}"
                                   FontFamily="Segoe UI" FontSize="13"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- Sitzplan Canvas -->
                <Border Grid.Row="3" Background="White" CornerRadius="8" Margin="4,4,4,0" Padding="12">
                    <DockPanel>
                        <!-- Legende + Bedienung – über den ℹ-Schalter im Banner ein-/ausklappbar.
                             Eingeklappt (Standard) belegt dieser Block keine Höhe → mehr Platz für den Plan. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                                    Visibility="{Binding HilfeAufgeklappt,
                                        Converter={StaticResource BoolVis}}">
                            <!-- Legende (bricht bei schmalem Fenster um) -->
                            <WrapPanel Margin="0,0,0,8">
                                <Border Width="18" Height="18" Background="#E74C3C" CornerRadius="3" Margin="0,0,5,3"/>
                                <TextBlock Text="Prio-3 Verletzung" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#FAD7A0" CornerRadius="3" Margin="0,0,5,3"/>
                                <TextBlock Text="Prio-2 Verletzung" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#FDEBD0" CornerRadius="3" Margin="0,0,5,3"/>
                                <TextBlock Text="Prio-1 Verletzung" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#D6E4F0" CornerRadius="3" Margin="0,0,5,3"/>
                                <TextBlock Text="Belegt" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#F5F5F5" CornerRadius="3" Margin="0,0,5,3"
                                        BorderBrush="#CCCCCC" BorderThickness="1"/>
                                <TextBlock Text="Frei" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#D6E4F0" CornerRadius="3" Margin="0,0,5,3"
                                        BorderBrush="#000000" BorderThickness="2"/>
                                <TextBlock Text="Markiert" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18" Background="#8E44AD" CornerRadius="9" Margin="0,0,5,3">
                                    <TextBlock Text="✗" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="kein Nebensitz-Wunsch erfüllt" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,0,14,3" VerticalAlignment="Center"/>
                                <TextBlock Text="[F]=Fixiert  !=Verletzung  neben X/Y=erfüllte Nebensitze" FontSize="13"
                                           Foreground="#1F3864" FontWeight="Bold" Margin="0,0,0,3" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,2">
                                <Run FontWeight="Bold">Ziehen:</Run>
                                <Run>Schüler auf anderen Platz ziehen um zu tauschen · In Wartezone ziehen um Platz freizugeben</Run>
                            </TextBlock>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#333" TextWrapping="Wrap">
                                <Run FontWeight="Bold">Rechtsklick:</Run>
                                <Run>Notiz anzeigen/bearbeiten · </Run>
                                <Run FontWeight="Bold">Doppelklick:</Run>
                                <Run>Fixieren · Nach Änderungen zur Kontrolle </Run>
                                <Run FontWeight="Bold">Prüfen</Run>
                                <Run>klicken</Run>
                            </TextBlock>
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,6"
                                Background="#FFF2CC" CornerRadius="6"
                                BorderBrush="#F0AD00" BorderThickness="1"
                                MinHeight="40"
                                AllowDrop="True"
                                Drop="Wartezone_Drop"
                                DragOver="Wartezone_DragOver">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Wartezone: "
                                           FontFamily="Segoe UI Semibold" FontSize="10"
                                           Foreground="#7D5A00" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ItemsControl ItemsSource="{Binding Wartezone}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="4"
                                                    Padding="6,3" Margin="2"
                                                    BorderBrush="#F0AD00" BorderThickness="1"
                                                    Cursor="SizeAll"
                                                    MouseLeave="WartezoneItem_MouseLeave"
                                                    MouseMove="WartezoneItem_MouseMove">
                                                <TextBlock Text="{Binding}" FontSize="10"
                                                           FontFamily="Segoe UI"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Sitzplan_PreviewMouseWheel">
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                                </Grid.LayoutTransform>
                                <Border Background="#1F3864" Height="26" VerticalAlignment="Top"
                                        CornerRadius="4" Margin="0,0,0,0">
                                    <TextBlock Text="TAFEL / VORNE" Foreground="White"
                                               FontWeight="SemiBold" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Canvas Margin="0,34,0,0"
                                        Width="{Binding PlanBreite}" Height="{Binding PlanHoehe}">
                                    <!-- Gruppen-Labels -->
                                    <ItemsControl ItemsSource="{Binding Gruppen}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft, Mode=OneWay}"/>
                                                <Setter Property="Canvas.Top"  Value="{Binding CanvasTop,  Mode=OneWay}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                   FontSize="9" Foreground="#888" Margin="2,0,2,1"/>
                                                        <TextBlock Text="↕" FontSize="9" Foreground="#BBBBBB"
                                                                   Visibility="{Binding IstVertikal, Mode=OneWay,
                                                                       Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="↔" FontSize="9" Foreground="#BBBBBB"
                                                                   Visibility="{Binding IstVertikal, Mode=OneWay,
                                                                       Converter={StaticResource InvBoolVis}}"/>
                                                    </StackPanel>
                                                    <Border Height="2" Opacity="0.25" Background="#1F3864"
                                                            Width="{Binding Breite, Mode=OneWay}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sitzplatz-Karten -->
                                    <ItemsControl ItemsSource="{Binding Sitzplaetze}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft, Mode=OneWay}"/>
                                                <Setter Property="Canvas.Top"  Value="{Binding CanvasTop,  Mode=OneWay}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="116" Height="78" Margin="2"
                                                        CornerRadius="6"
                                                        BorderThickness="{Binding RandStaerke, Mode=OneWay}"
                                                        BorderBrush="{Binding RandFarbe, Mode=OneWay,
                                                            Converter={StaticResource HexBrush}}"
                                                        Cursor="Hand"
                                                        AllowDrop="True"
                                                        MouseMove="Sitzplatz_MouseMove"
                                                        MouseRightButtonUp="Sitzplatz_RightClick"
                                                        Drop="Sitzplatz_Drop"
                                                        DragOver="Sitzplatz_DragOver"
                                                        Background="{Binding Farbe, Mode=OneWay,
                                                            Converter={StaticResource HexBrush}}">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                            Command="{Binding DataContext.SitzplatzKlickCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                            Command="{Binding DataContext.SitzplatzDoppelklickCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       FontSize="9" Foreground="#555555">
                                                                <Run Text="{Binding Gruppe, Mode=OneWay}"/>
                                                                <Run Text=" P"/>
                                                                <Run Text="{Binding PlatzNr, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                                       FontWeight="SemiBold" FontSize="13"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       TextAlignment="Center"
                                                                       MaxWidth="108"/>
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding Geschlecht, Mode=OneWay}"
                                                                           FontSize="10" Foreground="#555"/>
                                                                <TextBlock Text=" !" FontSize="10" FontWeight="Bold"
                                                                           Foreground="#C0392B"
                                                                           Visibility="{Binding HatVerletzung, Mode=OneWay,
                                                                               Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- F = Fixiert, rechts unten -->
                                                        <TextBlock Text="{Binding FixLabel, Mode=OneWay}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="Black"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,6,4"
                                                                   Visibility="{Binding Fixiert, Mode=OneWay,
                                                                       Converter={StaticResource BoolVis}}"/>
                                                        <!-- Nebensitz-Fortschritt, links unten -->
                                                        <TextBlock Text="{Binding NebenText, Mode=OneWay}"
                                                                   FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{Binding NebenFarbe, Mode=OneWay,
                                                                       Converter={StaticResource HexBrush}}"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="6,0,0,4"
                                                                   ToolTip="Erfüllte von gewünschten Nebensitz-Plätzen (Zusammen mit)"
                                                                   Visibility="{Binding HatNebenWunsch, Mode=OneWay,
                                                                       Converter={StaticResource BoolVis}}"/>
                                                        <!-- Eckabzeichen: kein Nebensitz-Wunsch erfüllt (0/1 oder 0/2) -->
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                                Margin="4,3,0,0" Width="17" Height="17"
                                                                Background="#8E44AD" CornerRadius="8.5"
                                                                ToolTip="Kein gewünschter Nebensitz erfüllt"
                                                                Visibility="{Binding KeineNebenErfuellt, Mode=OneWay,
                                                                    Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="✗" Foreground="White"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#1F3864" Padding="16,9">
            <DockPanel>
                <TextBlock FontFamily="Segoe UI Light"
                           FontSize="18" Foreground="White" VerticalAlignment="Center"
                           DockPanel.Dock="Left" ToolTip="{Binding ExcelPfad}">
                    <Run Text="📄 "/><Run Text="{Binding ExcelDateiName, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Excel laden"  Style="{StaticResource BtnBlue}"
                            Command="{Binding ExcelLadenCommand}"   Margin="0,0,8,0"/>
                    <Button Content="Speichern unter…" Style="{StaticResource BtnBlue}"
                            Command="{Binding SchuelerSpeichernUnterCommand}"
                            IsEnabled="{Binding IstGeladen}"        Margin="0,0,8,0"
                            ToolTip="Schülerdaten, Wünsche, Fixierungen und Parameter in einer wählbaren Excel-Datei speichern"/>
                    <Button Content="Neuoptimierung" Style="{StaticResource BtnGreen}"
                            Command="{Binding OptimierenCommand}"
                            IsEnabled="{Binding IstGeladen}"        Margin="0,0,8,0"/>
                    <Button Content="Gespeicherte Lösung laden" Style="{StaticResource BtnBlue}"
                            Command="{Binding GespeicherteLoesungLadenCommand}"
                            IsEnabled="{Binding IstGeladen}" Margin="0,0,8,0"
                            ToolTip="Die in der Excel-Datei gespeicherte Lösung wiederherstellen"/>
                    <Button Content="Exportieren"  Style="{StaticResource Btn}"
                            Command="{Binding ExportierenCommand}"
                            IsEnabled="{Binding IstOptimiert}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border DockPanel.Dock="Bottom" Background="#EEF2F7" Padding="16,5"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontFamily="Segoe UI" FontSize="10"/>
        </Border>

        <!-- Main -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Linke Spalte -->
            <DockPanel Grid.Column="0">

                <!-- Schülerliste -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Style="{StaticResource H2}" DockPanel.Dock="Top">
                            Schüler (<Run Text="{Binding Schueler.Count, Mode=OneWay}"/>)
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Top" FontSize="9" Foreground="#888"
                                   Margin="0,0,0,4">
                            Klick = bearbeiten  |  Doppelklick = im Sitzplan markieren (gelb)
                        </TextBlock>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Sortieren:"
                                       VerticalAlignment="Center" FontSize="10"
                                       Foreground="#555" Margin="0,0,4,0"/>
                            <ComboBox FontSize="10" FontFamily="Segoe UI"
                                      SelectedIndex="{Binding SchuelerSortModus, Mode=TwoWay}"
                                      ToolTip="Reihenfolge der Anzeige – ändert Daten und Nummerierung nicht">
                                <ComboBoxItem Content="Originalreihenfolge"/>
                                <ComboBoxItem Content="Nachname (A–Z)"/>
                                <ComboBoxItem Content="Vorname (A–Z)"/>
                            </ComboBox>
                        </DockPanel>
                        <Button DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                Content="🗑 Ausgewählten Schüler löschen"
                                Style="{StaticResource BtnRed}"
                                Padding="8,5" FontSize="11"
                                Command="{Binding SchuelerAusListeLoeschenCommand}"
                                ToolTip="Entfernt den in der Liste markierten Schüler dauerhaft"/>
                        <ListBox x:Name="lstSchueler"
                                 ItemsSource="{Binding Schueler}"
                                 SelectedItem="{Binding GewaehlterSchueler}"
                                 Height="155" BorderBrush="#DDDDDD"
                                 FontFamily="Segoe UI" FontSize="11"
                                 PreviewTextInput="LstSchueler_PreviewTextInput"
                                 MouseDoubleClick="ListSchueler_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource IstMarkiertConv}">
                                                    <Binding Path="."/>
                                                    <Binding Path="DataContext.MarkierterSchueler"
                                                             RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="#FFF3B0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Wünsche -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}">Wünsche</TextBlock>
                        <Border Background="#EBF3FB" CornerRadius="4" Padding="8,5"
                                Margin="0,0,0,8"
                                Visibility="{Binding IstGeladen, Converter={StaticResource BoolVis}}">
                            <TextBlock FontFamily="Segoe UI Semibold" FontSize="14"
                                       Foreground="#1F3864"
                                       Text="{Binding GewaehlterSchueler.Name, Mode=OneWay,
                                              FallbackValue='— kein Schüler ausgewählt —'}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Style="{StaticResource Lbl}" Margin="0,0,0,6"
                                   Visibility="{Binding IstGeladen, Converter={StaticResource BoolVis}}">
                            Tippen → Enter fügt hinzu · Badge klicken = Prio 1/2/3 · ✕ entfernt
                        </TextBlock>
                        <TextBlock Text="{Binding NamenSuchHinweis}"
                                   FontFamily="Segoe UI" FontSize="10" Foreground="#1F7A4A"
                                   Margin="0,0,0,6" TextWrapping="Wrap"
                                   Visibility="{Binding IstGeladen, Converter={StaticResource BoolVis}}"/>

                        <!-- Zwei Kategorien über den impliziten DataTemplate -->
                        <ContentControl Content="{Binding WuenscheEditor.Zusammen}"
                                        IsEnabled="{Binding IstGeladen}"/>
                        <ContentControl Content="{Binding WuenscheEditor.NichtNeben}"
                                        IsEnabled="{Binding IstGeladen}"/>

                        <CheckBox Content="gegenseitig übernehmen (Rückwunsch automatisch setzen)"
                                  IsChecked="{Binding WuenscheEditor.Gegenseitig}"
                                  IsEnabled="{Binding IstGeladen}"
                                  FontFamily="Segoe UI" FontSize="11" Foreground="#555"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Verbote -->
                <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}">Verbote</TextBlock>
                        <Border Background="#EBF3FB" CornerRadius="4" Padding="8,5"
                                Margin="0,0,0,8"
                                Visibility="{Binding IstGeladen, Converter={StaticResource BoolVis}}">
                            <TextBlock FontFamily="Segoe UI Semibold" FontSize="14"
                                       Foreground="#1F3864"
                                       Text="{Binding GewaehlterSchueler.Name, Mode=OneWay,
                                              FallbackValue='— kein Schüler ausgewählt —'}"
                                       TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Style="{StaticResource Lbl}" TextWrapping="Wrap">
                            Gruppen oder einzelne Plätze die für diesen Schüler gesperrt sind.
                        </TextBlock>
                        <TextBlock Text="{Binding GewaehlterSchueler.VerboteText, Mode=OneWay,
                                          FallbackValue=''}"
                                   FontSize="10" Foreground="#C0392B"
                                   TextWrapping="Wrap" Margin="0,4,0,6"
                                   Visibility="{Binding GewaehlterSchueler.HatVerbote, Mode=OneWay,
                                       Converter={StaticResource BoolVis}}"/>
                        <Button Content="Verbote bearbeiten..."
                                Style="{StaticResource BtnRed}"
                                Padding="8,5" FontSize="11"
                                Click="BtnVerboteBearbeiten_Click"
                                IsEnabled="{Binding IstGeladen}"/>
                    </StackPanel>
                </Border>

                <!-- Gruppen -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock Style="{StaticResource H2}" DockPanel.Dock="Top">Tischgruppen</TextBlock>
                        <ListBox ItemsSource="{Binding Gruppen}" BorderBrush="#DDDDDD"
                                 FontFamily="Segoe UI" FontSize="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="90"/>
                                        <TextBlock Text="R" FontSize="9" Foreground="#999"/>
                                        <TextBlock Text="{Binding Reihe}" FontSize="9" Margin="1,0,4,0"/>
                                        <TextBlock Text="S" FontSize="9" Foreground="#999"/>
                                        <TextBlock Text="{Binding Spalte}" FontSize="9" Margin="1,0,4,0"/>
                                        <TextBlock Text="|" FontSize="9" Foreground="#CCC" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Sitzplaetze}" FontSize="9"/>
                                        <TextBlock Text=" Pl." FontSize="9" Foreground="#999"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- Rechte Spalte -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding AktiveLoesung}">

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding Loesungen[0].TabHeader, FallbackValue='Lösung 1'}"/>
                    </TabItem.Header>
                    <ContentControl Content="{Binding Loesungen[0]}"
                                    ContentTemplate="{StaticResource LoesungTemplate}"/>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding Loesungen[1].TabHeader, FallbackValue='Lösung 2'}"/>
                    </TabItem.Header>
                    <ContentControl Content="{Binding Loesungen[1]}"
                                    ContentTemplate="{StaticResource LoesungTemplate}"/>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="{Binding Loesungen[2].TabHeader, FallbackValue='Lösung 3'}"/>
                    </TabItem.Header>
                    <ContentControl Content="{Binding Loesungen[2]}"
                                    ContentTemplate="{StaticResource LoesungTemplate}"/>
                </TabItem>

                <!-- Gespeicherte Lösung (nur sichtbar, wenn vorhanden) -->
                <TabItem Visibility="{Binding HatGespeicherteLoesung, Converter={StaticResource BoolVis}}">
                    <TabItem.Header>
                        <TextBlock Text="★ Gespeicherte Lösung" Foreground="#8E44AD"
                                   FontFamily="Segoe UI Semibold"/>
                    </TabItem.Header>
                    <ContentControl Content="{Binding GespeicherteLoesung}"
                                    ContentTemplate="{StaticResource LoesungTemplate}"/>
                </TabItem>

                <!-- Schüler -->
                <TabItem Header="Schüler">
                    <views:SchuelerTab x:Name="schuelerTab"
        DataContext="{Binding SchuelerVM}"
        xmlns:views="clr-namespace:SitzplanApp.Views"/>
                </TabItem>
                <!-- Raumplan -->
                <TabItem Header="Raumplan">
                    <views:RaumplanTab x:Name="raumplanTab"
                        DataContext="{Binding RaumplanVM}"
                        xmlns:views="clr-namespace:SitzplanApp.Views"/>
                </TabItem>

                <!-- Fixierung -->
                <TabItem Header="Fixierung">
                    <views:FixierungsTab x:Name="fixierungsTab"
                        DataContext="{Binding FixierungsVM}"
                        xmlns:views="clr-namespace:SitzplanApp.Views"/>
                </TabItem>

                <!-- Wunsch-Matrix -->
                <TabItem Header="Wunsch-Matrix">
                    <views:WunschMatrixTab x:Name="wunschMatrixTab"
                        DataContext="{Binding WunschMatrixVM}"
                        xmlns:views="clr-namespace:SitzplanApp.Views"/>
                </TabItem>

                <!-- Parameter -->
                <TabItem Header="Parameter">
                    <Border Background="White" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                                <TextBlock Text="Gewichtungs-Parameter"
                                           FontFamily="Segoe UI Semibold" FontSize="13"
                                           Foreground="#1F3864" Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666"
                                           Margin="0,0,0,14">
                                    Diese Werte steuern, wie stark die einzelnen Kriterien in die
                                    Optimierung einfließen. Höhere Zahl = wichtiger. Nach dem Ändern
                                    „Anwenden &amp; neu optimieren" klicken. Mit „Speichern" werden die
                                    Werte auch in die Excel-Datei geschrieben.
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Linke Spalte: Belohnungen -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Belohnungen (erfüllte Wünsche)"
                                                   Style="{StaticResource H2}"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Prio-2 erfüllt" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Bonus, wenn ein Prio-2-Wunsch erfüllt wird"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_PRIO2_ERF}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Prio-1 erfüllt" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Bonus, wenn ein Prio-1-Wunsch erfüllt wird"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_PRIO1_ERF}"/>
                                        </Grid>

                                        <TextBlock Text="Weitere Kriterien"
                                                   Style="{StaticResource H2}" Margin="0,8,0,6"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Sehschwäche vorne" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Bonus, Schüler mit Sehschwäche vorne zu setzen"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_SEH_VORNE}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Geschlechtermischung" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Bonus für ausgewogene Geschlechterverteilung"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_GESCHLECHT}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Linkshänder" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Bonus für günstige Platzierung von Linkshändern"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_LINKSHAENDER}"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Rechte Spalte: Strafen -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Strafen (verletzte Wünsche)"
                                                   Style="{StaticResource H2}"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Prio-2 Strafe" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Abzug, wenn ein Prio-2-Wunsch verletzt wird"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_PRIO2_STRAF}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="Prio-1 Strafe" FontSize="12" Foreground="#222"/>
                                                <TextBlock Text="Abzug, wenn ein Prio-1-Wunsch verletzt wird"
                                                           FontSize="10" Foreground="#888" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" BorderBrush="#CFCFCF" BorderThickness="1"
                                                     IsEnabled="{Binding IstGeladen}"
                                                     Text="{Binding Parameter.W_PRIO1_STRAF}"/>
                                        </Grid>

                                        <Border Background="#F1F5FB" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#33506E">
                                                Hinweis: Prio-3-Wünsche sind zwingend und werden nicht über
                                                Gewichte gesteuert. Für ein „konfliktfreies" Ergebnis sollten
                                                die Strafen deutlich größer sein als die Belohnungen.
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Anwenden &amp; neu optimieren"
                                            Style="{StaticResource BtnGreen}"
                                            Command="{Binding ParameterAnwendenCommand}"
                                            IsEnabled="{Binding IstGeladen}" Margin="0,0,8,0"/>
                                    <Button Content="Auf Standard zurücksetzen"
                                            Style="{StaticResource Btn}"
                                            Command="{Binding ParameterZuruecksetzenCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

                <!-- Diagnose -->
                <TabItem Header="Diagnose">
                    <Border Background="White" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Diagnose und Lösungsvergleich"
                                       FontFamily="Segoe UI Semibold" FontSize="13"
                                       Foreground="#1F3864" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding Diagnose}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      FontFamily="Segoe UI" FontSize="11"
                                      RowHeight="28" BorderBrush="#DDDDDD">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kriterium"
                                                        Binding="{Binding Kriterium}"
                                                        Width="200" FontWeight="SemiBold"/>
                                    <DataGridTemplateColumn Header="Lösung 1" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Farbe1,
                                                            Converter={StaticResource HexBrush}}"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding Wert1}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Lösung 2" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Farbe2,
                                                            Converter={StaticResource HexBrush}}"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding Wert2}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Lösung 3" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Farbe3,
                                                            Converter={StaticResource HexBrush}}"
                                                        Padding="4,2">
                                                    <TextBlock Text="{Binding Wert3}"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Beste" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#E2EFDA" Padding="4,2">
                                                    <TextBlock Text="{Binding BesterWert}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
