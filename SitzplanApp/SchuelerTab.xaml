<UserControl x:Class="SitzplanApp.Views.SchuelerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SitzplanApp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10,8"
                Margin="0,0,0,6">
            <DockPanel>
                <Button Content="+ Neuer Schüler" DockPanel.Dock="Left"
                        Background="#27AE60" Foreground="White" BorderThickness="0"
                        Padding="10,5" FontSize="11" FontFamily="Segoe UI"
                        Cursor="Hand"
                        Command="{Binding NeuerSchuelerCommand}"
                        Margin="0,0,8,0"/>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="10" Foreground="#888"
                           Text="Bearbeiten: direkt in der Tabelle  |  Wünsche/Verbote/Fixierung: eigene Tabs  |  Danach oben „Speichern“ + „Neuoptimierung“"/>

                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#1F3864"
                           FontWeight="SemiBold">
                    <Run Text="{Binding Zeilen.Count, Mode=OneWay}"/>
                    <Run Text=" Schüler"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Tabelle -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="6">
            <DataGrid ItemsSource="{Binding Zeilen}"
                      SelectedItem="{Binding GewaehlteZeile, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      RowHeight="30"
                      FontFamily="Segoe UI" FontSize="11"
                      BorderBrush="#DDDDDD"
                      ColumnHeaderHeight="40"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#DCE6F2"/>
                        <Setter Property="Foreground" Value="#14294B"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize"   Value="13"/>
                        <Setter Property="Padding"    Value="8,4"/>
                        <Setter Property="BorderBrush" Value="#B9C9DE"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Ausgewählte (in Bearbeitung befindliche) Zeile: GELB statt Blau -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFE24D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Zellen der ausgewählten Zeile: gelber Hintergrund, alle Buchstaben groß + fett -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background"  Value="#FFE24D"/>
                                <Setter Property="BorderBrush" Value="#FFE24D"/>
                                <Setter Property="Foreground"  Value="#111111"/>
                                <Setter Property="FontSize"    Value="14"/>
                                <Setter Property="FontWeight"  Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- Nr. -->
                    <DataGridTemplateColumn Header="Nr." Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nr}" Foreground="#999"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name -->
                    <DataGridTemplateColumn Header="Name" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Geschlecht -->
                    <DataGridTemplateColumn Header="Gesch." Width="58">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          BorderThickness="0" Background="Transparent"
                                          VerticalContentAlignment="Center"
                                          Text="{Binding Geschlecht, UpdateSourceTrigger=LostFocus}">
                                    <ComboBoxItem Content="m"/>
                                    <ComboBoxItem Content="w"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Sehschwäche -->
                    <DataGridTemplateColumn Header="Seh-&#10;schwäche" Width="66">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Sehschwaeche}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Linkshänder -->
                    <DataGridTemplateColumn Header="Links-&#10;händer" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Linkshaender}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Notizen -->
                    <DataGridTemplateColumn Header="Notizen" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Notizen, UpdateSourceTrigger=LostFocus}"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Wünsche (read-only Info) -->
                    <DataGridTemplateColumn Header="Wünsche  (in „Wunsch-Matrix“ bearbeiten)" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding WuenscheText}" Foreground="#555"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding WuenscheText}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fixierung / Verbote (read-only Info) -->
                    <DataGridTemplateColumn Header="Fixierung / Verbote" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FixierungText}" Foreground="#1E6B34"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VerboteText}" Foreground="#C0392B"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Löschen -->
                    <DataGridTemplateColumn Header="" Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑" ToolTip="Diesen Schüler löschen"
                                        FontSize="12" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="#C0392B"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.SchuelerLoeschenCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
